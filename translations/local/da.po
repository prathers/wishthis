# upstream wishthis never conflicts. Loaded on top of translations/da_DK.po
# and translations/da.po; entries here win. Edit with Poedit or any text editor.
#
msgid ""
msgstr ""
"Project-Id-Version: wishthis (prathers fork)\n"
"Language: da\n"
