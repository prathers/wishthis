#: classes/wishthis/Wish.php:270
msgid "You are fulfilling this wish"
msgstr "Du opfylder dette ønske"

#: classes/wishthis/Wish.php:270
msgid "Somebody is already fulfilling this wish"
msgstr "Nogen er allerede i gang med at opfylde dette ønske"

#: classes/wishthis/Wish.php:277
msgid "Un-fulfil"
msgstr "Fortryd opfyldelse"

#: api/wishes.php:322
msgid "Wish not found."
msgstr "Ønske ikke fundet."

#: api/wishes.php:328
msgid "You must be logged in to fulfil a wish."
msgstr "Du skal være logget ind for at opfylde et ønske."

#: api/wishes.php:340
msgid "Only the owner of a wishlist can mark a wish as fulfilled."
msgstr "Kun ejeren af ønskelisten kan markere et ønske som opfyldt."

#: api/wishes.php:349
msgid "You cannot fulfil a wish on your own wishlist."
msgstr "Du kan ikke opfylde et ønske på din egen ønskeliste."

#: api/wishes.php:354
msgid "This wish is already being fulfilled by somebody else."
msgstr "Dette ønske er allerede ved at blive opfyldt af en anden."

#: api/wishes.php:368
msgid "Only the user who fulfilled this wish can un-fulfil it."
msgstr "Kun den bruger, der opfyldte dette ønske, kan fortryde opfyldelsen."

#: api/wishes.php:376
msgid "Invalid wish status."
msgstr "Ugyldig ønskestatus."

#: assets/js/inline.js.php:84
msgid "Please log in"
msgstr "Log venligst ind"

#: assets/js/inline.js.php:85
msgid "You need to be logged in to fulfil a wish. This way only you can un-fulfil it again later."
msgstr "Du skal være logget ind for at opfylde et ønske. På den måde er det kun dig, der kan fortryde opfyldelsen igen senere."

#: pages/home.php:96
msgid "Your birthday is coming up and you just created a wishlist with all the cool stuff you want. Your friends and family want to make sure you get something you are happy with so you send them your wishlist link. When somebody decides to fulfil one of your wishes, it is marked as taken for everybody else, so nobody buys the same gift twice."
msgstr "Du har snart fødselsdag, og du har lige oprettet en ønskeliste med alle de fede ting, du ønsker dig. Dine venner og familie vil gerne sikre sig, at du får noget, som du er glad for, så du sender dem dit link til ønskelisten. Når nogen beslutter sig for at opfylde et af dine ønsker, bliver det markeret som optaget for alle andre, så ingen køber den samme gave to gange."

#: assets/js/inline.js.php
msgid "Could not fetch details"
msgstr "Kunne ikke hente oplysninger"

#: assets/js/inline.js.php
msgid "This website does not allow automatic fetching. Please fill in the title, description and image yourself. The link has been saved."
msgstr "Denne hjemmeside tillader ikke automatisk hentning. Udfyld selv titel, beskrivelse og billede. Linket er gemt."

#: pages/settings.php
msgid "Emails (password reset, wish requests) are sent directly from this server."
msgstr "E-mails (nulstilling af adgangskode, ønskeanmodninger) sendes direkte fra denne server."

#: pages/settings.php
msgid "Sender"
msgstr "Afsender"

#: pages/settings.php
#, php-format
msgid "To use a different sender, define %s in %s. The domain of the sender should have SPF and DKIM set up, otherwise emails may end up as spam."
msgstr "Definér %s i %s for at bruge en anden afsender. Afsenderens domæne bør have SPF og DKIM sat op, ellers kan e-mails havne i spam."

# Corrections to upstream's Danish wording (moved from da_DK.po, 2026-11-08)

msgid "Hello,"
msgstr "Hej med dig"

msgid "Contribute"
msgstr "Bidrag"

msgid "Hey, you"
msgstr "Hej, du"

msgid "source code"
msgstr "kildekode"

msgid "Account details"
msgstr "Kontodetaljer"

msgid "Mercury"
msgstr "Merkur"

msgid "Sun"
msgstr "Solen"

msgid "An account with this email address already exists."
msgstr "Der findes allerede en konto med denne e-mail-adresse."

msgid "Currently the email address is used as a unique identifier and does not have to be verified. You may enter a fake address."
msgstr "I øjeblikket bruges e-mail-adressen som en unik identifikator og behøver ikke at blive verificeret. Du kan indtaste en falsk adresse."

msgid "This password reset link has expired, please request a new one."
msgstr "Dette link til nulstilling af adgangskode er udløbet. Anmod venligst om et nyt."

#, php-format
msgid "somebody has requested a password reset for this email address from %s. If this was you, click the button below to invalidate your current password and set a new one."
msgstr "nogen har anmodet om en nulstilling af adgangskoden til denne e-mailadresse fra %s. Hvis det var dig, skal du klikke på knappen nedenfor for at annullere din nuværende adgangskode og indstille en ny."

msgid "amazon links are automatically converted to affiliate links to help support the project financially."
msgstr "amazon-links konverteres automatisk til affiliate-links for at hjælpe med at støtte projektet økonomisk."

msgid "A fatal error when the CHANNELS constant is removed from the config"
msgstr "En fatal fejl, når CHANNELS-konstanten fjernes fra konfigurationen"

msgid "Additional logins are no longer required when switching between wishthis channels"
msgstr "Yderligere logins er ikke længere nødvendige, når man skifter mellem wishthis-kanaler"

msgid "Fulfil wish"
msgstr "Opfyld ønske"

#, php-format
msgid "If you found a wish you would like to fulfil, open the wish %s and then click the %s button and it will be unavailable for everybody else."
msgstr "Hvis du har fundet et ønske, du gerne vil opfylde, skal du åbne ønsket ved at klikke på %s og derefter klikke på knappen %s, så bliver det utilgængeligt for alle andre."

#, php-format
msgid "%d more subscriber needed"
msgid_plural "%d more subscribers needed"
msgstr[0] "%d abonnent mere er nødvendig"
msgstr[1] "%d abonnenter mere er nødvendige"
